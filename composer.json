{
  "name": "nedieyassin/laravel-messaging-gateway",
  "description": "Notification channels and helpers for the messaging gateway (WhatsApp, SMS, email, push)",
  "version": "0.0.1",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0",
    "illuminate/http": "^11.0.0|^12.0.0",
    "illuminate/notifications": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Nedieyassin\\MessagingGateway\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nedieyassin\\MessagingGateway\\GatewayServiceProvider"
      ],
      "aliases": {
        "Gateway": "Gateway"
      }
    }
  },
  "minimum-stability": "stable"
}